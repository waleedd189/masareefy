# ─────────────────────────────────────────────────────────────
# مصاريفي — متغيرات البيئة
# انسخ الملف ده لـ `.env.local` (محلي) أو حطّ القيم في لوحة الاستضافة (Vercel)
# كل المتغيرات اختيارية: من غيرهم التطبيق بيشتغل بقاعدة SQLite محلية في ./data
# ─────────────────────────────────────────────────────────────

# قاعدة البيانات
# محلي (افتراضي): file:./data/masareefy.db
# Turso/سحابي:     libsql://xxxx.turso.io
DATABASE_URL="file:./data/masareefy.db"

# توكن القاعدة (مطلوب مع Turso فقط)
# turso db tokens create masareefy
DATABASE_AUTH_TOKEN=""

# ── بوابة الدخول (مهم جدًا لو هتنشر علني) ─────────────────────
# التطبيق مفيهوش تسجيل دخول، فأي رابط منشور على الإنترنت يبقى مكشوف.
# لو حطيت قيمة هنا، كل الصفحات هتطلب كلمة السر دي (HTTP Basic Auth) —
# المتصفح بيحفظها مرة واحدة. سيبها فاضية للاستخدام المحلي.
# مستثنى منها: /api/ingest (محمي بمفتاح API من صفحة الإعدادات) والملفات الساكنة.
APP_ACCESS_CODE=""

# ── اختياري ──────────────────────────────────────────────────
# بيئة التطوير/الإنتاج (Next.js بيضبطها بنفسه)
# NODE_ENV="production"

# ملاحظة: الـ migrations بتشتغل تلقائيًا عند بدء السيرفر (src/instrumentation.ts)
# وتقدر تشغّلها يدويًا كمان: npm run db:migrate
